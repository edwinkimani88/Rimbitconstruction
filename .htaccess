DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^app$ app/ [R=301,L]
</IfModule>

<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>

<FilesMatch "\.(apk|APK)$">
    Order Allow,Deny
    Allow from all
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>
